<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/unit_converter_picker_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calcova_bg_dark"
    android:orientation="vertical"
    tools:context="org.fossify.math.activities.UnitConverterPickerActivity"
    tools:ignore="HardcodedText">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/unit_converter_picker_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/calcova_bg_dark"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/unit_converter_picker_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/calcova_bg_dark"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/unit_types_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4"
        tools:itemCount="9"
        tools:listitem="@layout/item_unit_type" />

    <FrameLayout
        android:id="@+id/ad_banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center" />

</LinearLayout>
